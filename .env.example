# Configuration de l'API
VITE_API_URL=http://localhost:5000/api

# Clés d'API Stripe (à remplacer par vos propres clés en production)
VITE_STRIPE_PUBLIC_KEY=pk_test_votre_cle_publique_stripe
VITE_STRIPE_SECRET_KEY=sk_test_votre_cle_secrete_stripe

# Clé secrète pour les JWT (à changer en production)
JWT_SECRET=votre_cle_secrete_jwt

# Configuration de la base de données MongoDB
MONGODB_URI=mongodb://localhost:27017/sailingloc

# Configuration de l'email (optionnel)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=votre_email@example.com
# SMTP_PASS=votre_mot_de_passe
# EMAIL_FROM=noreply@votredomaine.com

# URL du frontend (utilisé pour les liens dans les emails)
FRONTEND_URL=http://localhost:3000

# Mode de l'application (development, production)
NODE_ENV=development

# Configuration CORS (pour le développement)
CORS_ORIGIN=http://localhost:3000
